#!/usr/bin/env bash
set -euo pipefail

USER_NAME="$(id -un)"
SHARE_DIR="${HOME}/.local/share/curb"

# Derive a tag-safe slug from an image reference (e.g. "myrepo/dev:1.0" → "myrepo-dev-1-0")
image_slug() {
    printf '%s' "$1" | tr -cs 'a-zA-Z0-9' '-' | sed 's/^-//;s/-$//'
}

usage() {
    cat <<EOF
Usage: curb TOOL [OPTIONS] [-- TOOL_ARGS...]
       curb init

Run TOOL in an isolated container, mounting the current directory
(or the directory given by -C) as the workspace.

The container image is built automatically on first run.
Available tools correspond to subdirectories of ~/.local/share/curb/.

Commands:
  init    Write .config/curb.conf in the current directory.
          Errors if the file already exists.
    -b, --base-image IMAGE     Base image to write into the config
                               (default: node:lts-slim)

Options:
  -C, --directory DIR        Change to DIR before doing anything
  -b, --base-image IMAGE     Base image to layer the tool on top of
                             (default: node:lts-slim). Must be
                             Debian/Ubuntu (apt-get) or RHEL/Fedora/UBI (dnf)
                             compatible. Each distinct base image gets its own
                             cached image.
  --rebuild                  Rebuild the container image from scratch (--no-cache)
  -h, --help                 Show this help message

Any arguments after -- are passed directly to the tool inside the container.
EOF
    exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# Global flags handled before tool selection
# ---------------------------------------------------------------------------
[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage 0

# ---------------------------------------------------------------------------
# init command (tool-agnostic)
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "init" ]]; then
    shift
    INIT_BASE_IMAGE="node:lts-slim"
    while [[ $# -gt 0 ]]; do
        case $1 in
            -b|--base-image)
                if [[ -z "${2:-}" ]]; then
                    echo "curb: --base-image requires an argument" >&2
                    usage 1
                fi
                INIT_BASE_IMAGE="$2"
                shift 2
                ;;
            -h|--help)
                usage 0
                ;;
            -*)
                echo "curb: unknown option for 'init': $1" >&2
                usage 1
                ;;
            *)
                echo "curb: unexpected argument for 'init': $1" >&2
                usage 1
                ;;
        esac
    done
    CONF_FILE=".config/curb.conf"
    if [[ -f "$CONF_FILE" ]]; then
        echo "curb: '${PWD}/${CONF_FILE}' already exists; delete it to reinitialize" >&2
        exit 1
    fi
    mkdir -p .config
    cat > "$CONF_FILE" <<EOF
# curb configuration
# Sourced before CLI argument parsing; CLI flags take precedence.

# Base image to layer each tool on top of.
# Must be Debian/Ubuntu (apt-get) or RHEL/Fedora/UBI (dnf) compatible.
# Each distinct base image gets its own cached container image.
BASE_IMAGE="${INIT_BASE_IMAGE}"
EOF
    echo "curb: created ${PWD}/${CONF_FILE}" >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# Tool selection
# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
    echo "curb: no tool specified" >&2
    usage 1
fi

TOOL="$1"
shift

LIB="${SHARE_DIR}/${TOOL}/lib.sh"
if [[ ! -f "$LIB" ]]; then
    echo "curb: unknown tool '${TOOL}' (${LIB} not found)" >&2
    exit 1
fi

# Provide no-op defaults so lib.sh only needs to define what it uses.
get_extra_mounts() { :; }
get_extra_env() { :; }

# shellcheck source=/dev/null
source "$LIB"

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
BASE_IMAGE="node:lts-slim"

# shellcheck source=/dev/null
[[ -f "${HOME}/.config/curb.conf" ]] && source "${HOME}/.config/curb.conf"

# ---------------------------------------------------------------------------
# Argument parsing
# -C/--directory is handled immediately so the local config is loaded from
# the right place. Other config-affecting flags are saved as CLI_* overrides
# and applied after the local config is sourced.
# ---------------------------------------------------------------------------
REBUILD=false
TOOL_ARGS=()
CLI_BASE_IMAGE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -C|--directory)
            if [[ -z "${2:-}" ]]; then
                echo "curb: --directory requires an argument" >&2
                usage 1
            fi
            cd "$2"
            shift 2
            ;;
        --base-image|-b)
            if [[ -z "${2:-}" ]]; then
                echo "curb: --base-image requires an argument" >&2
                usage 1
            fi
            CLI_BASE_IMAGE="$2"
            shift 2
            ;;
        --rebuild)
            REBUILD=true
            shift
            ;;
        -h|--help)
            usage 0
            ;;
        --)
            shift
            TOOL_ARGS=("$@")
            break
            ;;
        -*)
            echo "curb: unknown option: $1" >&2
            usage 1
            ;;
        *)
            echo "curb: unexpected argument: $1" >&2
            usage 1
            ;;
    esac
done

# shellcheck source=/dev/null
[[ -f ".config/curb.conf" ]] && source ".config/curb.conf"

[[ -n "$CLI_BASE_IMAGE" ]] && BASE_IMAGE="$CLI_BASE_IMAGE"

COMMON_IMAGE_NAME="curb-common:uid-$(id -u)-$(image_slug "$BASE_IMAGE")"
IMAGE_NAME="${IMAGE_PREFIX}:uid-$(id -u)-$(image_slug "$BASE_IMAGE")"

# ---------------------------------------------------------------------------
# Image build
# ---------------------------------------------------------------------------
build_common_image() {
    local -a extra_args=()
    [[ "$REBUILD" == "true" ]] && extra_args+=("--no-cache")

    echo "curb: building common image ${COMMON_IMAGE_NAME} ..." >&2
    podman build \
        "${extra_args[@]}" \
        --build-arg BASE_IMAGE="$BASE_IMAGE" \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        --build-arg USER_NAME="$USER_NAME" \
        -f "${SHARE_DIR}/Dockerfile.common" \
        -t "$COMMON_IMAGE_NAME" \
        "$SHARE_DIR"
}

build_tool_image() {
    local -a extra_args=()
    [[ "$REBUILD" == "true" ]] && extra_args+=("--no-cache")

    echo "curb: building ${TOOL} image ${IMAGE_NAME} ..." >&2
    podman build \
        "${extra_args[@]}" \
        --build-arg COMMON_IMAGE="$COMMON_IMAGE_NAME" \
        --build-arg USER_NAME="$USER_NAME" \
        -f "${SHARE_DIR}/${TOOL}/Dockerfile" \
        -t "$IMAGE_NAME" \
        "${SHARE_DIR}/${TOOL}"
}

if [[ "$REBUILD" == "true" ]]; then
    build_common_image
    build_tool_image
elif ! podman image exists "$COMMON_IMAGE_NAME" 2>/dev/null; then
    build_common_image
    build_tool_image
elif ! podman image exists "$IMAGE_NAME" 2>/dev/null; then
    build_tool_image
fi

# ---------------------------------------------------------------------------
# Tool-specific pre-run setup and mounts
# get_extra_mounts and get_extra_env are defined in lib.sh (or are no-ops).
# They append flags to EXTRA_MOUNTS and EXTRA_ENV respectively, and may
# perform pre-run setup (e.g. creating host directories before mounting).
# ---------------------------------------------------------------------------
EXTRA_MOUNTS=()
EXTRA_ENV=()
get_extra_mounts
get_extra_env

# ---------------------------------------------------------------------------
# Read-only host mounts
# System gitconfig (/etc/gitconfig) is not relabelled (:z omitted) to avoid
# permanently changing SELinux labels on shared system files.
# ---------------------------------------------------------------------------
RO_HOST_MOUNTS=()
[[ -f "${HOME}/.gitconfig" ]] && \
    RO_HOST_MOUNTS+=(-v "${HOME}/.gitconfig:/home/${USER_NAME}/.gitconfig:ro,z")
[[ -d "${HOME}/.config/git" ]] && \
    RO_HOST_MOUNTS+=(-v "${HOME}/.config/git:/home/${USER_NAME}/.config/git:ro,z")
[[ -f "/etc/gitconfig" ]] && \
    RO_HOST_MOUNTS+=(-v "/etc/gitconfig:/etc/gitconfig:ro")

# ---------------------------------------------------------------------------
# SSH agent forwarding
# Forwards the host ssh-agent socket instead of bind-mounting ~/.ssh, so
# private key material never enters the container and ~/.ssh's SELinux
# labels are left untouched. Podman's :z/:Z relabeling does not reliably
# apply to bind-mounted sockets, so the container is run with SELinux
# labeling disabled instead (see --security-opt label=disable below) rather
# than relabeling the host's ssh-agent socket.
# ---------------------------------------------------------------------------
SSH_AGENT_MOUNTS=()
SSH_AGENT_ENV=()
SSH_AGENT_SECURITY_OPTS=()
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
    SSH_AGENT_MOUNTS+=(-v "${SSH_AUTH_SOCK}:/run/ssh-agent.sock")
    SSH_AGENT_ENV+=(--env "SSH_AUTH_SOCK=/run/ssh-agent.sock")
    SSH_AGENT_SECURITY_OPTS+=(--security-opt label=disable)
fi

# ---------------------------------------------------------------------------
# Environment variables forwarded to the container
# ---------------------------------------------------------------------------
FORWARDED_ENV=()
[[ -n "${EDITOR:-}" ]] && FORWARDED_ENV+=(--env "EDITOR=${EDITOR}")

# ---------------------------------------------------------------------------
# Run
#
# --userns=keep-id   maps the host UID:GID to the same UID:GID inside the
#                    container, which is what the Dockerfile user was built
#                    with. This avoids root inside the container and ensures
#                    bind-mounted files are readable/writable without chown.
#
# :z on each volume  adds the 'container_file_t' SELinux label so the
#                    container process is allowed to access the files.
#                    Lower-case :z marks the label as shared (safe for home
#                    directory contents that may be accessed by other
#                    confined processes). Use :Z (private) only on
#                    directories that are exclusively owned by this
#                    container.
# ---------------------------------------------------------------------------
exec podman run \
    --rm \
    --interactive \
    --tty \
    --userns=keep-id \
    "${SSH_AGENT_SECURITY_OPTS[@]+"${SSH_AGENT_SECURITY_OPTS[@]}"}" \
    -v "${PWD}:/workspace:z" \
    "${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}" \
    "${RO_HOST_MOUNTS[@]+"${RO_HOST_MOUNTS[@]}"}" \
    "${SSH_AGENT_MOUNTS[@]+"${SSH_AGENT_MOUNTS[@]}"}" \
    "${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}" \
    "${FORWARDED_ENV[@]+"${FORWARDED_ENV[@]}"}" \
    "${SSH_AGENT_ENV[@]+"${SSH_AGENT_ENV[@]}"}" \
    "$IMAGE_NAME" \
    "${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"}"
